{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PokéBedrock Doc Frontmatter",
  "type": "object",
  "required": [
    "title",
    "description",
    "tags",
    "lastUpdated"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true
    },
    "lastUpdated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date string (YYYY-MM-DD)."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "beta",
        "stable",
        "deprecated"
      ],
      "default": "stable"
    },
    "lang": {
      "type": "string",
      "enum": [
        "en",
        "es",
        "fr",
        "de",
        "pt",
        "it",
        "ja"
      ],
      "default": "en"
    },
    "toc": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  },
  "additionalProperties": true
}


